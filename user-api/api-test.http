

curl 'http://localhost:4000/health'


### 

// success scenario sample
curl -X GET 'http://localhost:4000/api/internal/users' \
  -H 'X-Verified-User: "a@a.com"'

### 
// failure scenario sample i.e. no X-Verified-User provided, so backend should block this request
curl -X GET 'http://localhost:4000/api/internal/users'

### 

curl -X GET 'http://localhost:4000/api/internal/users/<copy-from-post-response>' \
  -H 'X-Verified-User: "a@a.com"'

### 

curl -X POST 'http://localhost:4000/api/internal/users' \
  -H 'content-type: application/json' \
  -H 'X-Verified-User: "a@a.com"' \
  -d '{
    "name": "John Connor",
    "email": "jc@sample.com"
}'


### 

curl -X PUT 'http://localhost:4000/api/internal/users/<copy-from-post-response>' \
  -H 'content-type: application/json' \
  -H 'X-Verified-User: "a@a.com"' \
  -d '{
    "name": "John Connor",
    "email": "jc1.new@sample.com",
    "id": "<copy-from-post-response>"
}'

### 

curl -X DELETE 'http://localhost:4000/api/internal/users/<copy-from-post-response>' \
  -H 'X-Verified-User: "a@a.com"'